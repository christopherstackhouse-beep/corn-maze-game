{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lester-after-dark",
  "main": "server/leaderboard.mjs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lester-leaderboard",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": ""
  },
  "triggers": {
    "crons": [
      "17 4 * * *"
    ]
  }
}
